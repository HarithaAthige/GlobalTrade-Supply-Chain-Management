<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="supplyChainPU" transaction-type="JTA">
        <jta-data-source>java:/SupplyChainDS</jta-data-source>

        <class>com.globaltrade.scm.entity.Vendor</class>
        <class>com.globaltrade.scm.entity.InventoryItem</class>
        <class>com.globaltrade.scm.entity.Shipment</class>
        <class>com.globaltrade.scm.entity.AppRole</class>
        <class>com.globaltrade.scm.entity.AppUser</class>
        <class>com.globaltrade.scm.entity.AuditLog</class>

        <properties>
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
        </properties>
    </persistence-unit>
</persistence>